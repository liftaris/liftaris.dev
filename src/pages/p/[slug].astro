---
import { getEmDashEntry, getEmDashCollection } from "emdash";
import { PortableText } from "emdash/ui";
import Portfolio from "../../layouts/Portfolio.astro";
import ThemeImage from "../../components/ThemeImage.astro";
import ContentImage from "../../components/ContentImage.astro";

const slug = Astro.params.slug!;
let thing: any = null;
let cacheHint: any = undefined;

try {
  const { entry, error, cacheHint: hint } = await getEmDashEntry("things", slug);
  if (!error && entry && entry.data.kind === "page") {
    thing = entry;
    cacheHint = hint;
  }
} catch {
  // If slug lookup throws, fall back to collection lookup
}

if (!thing) {
  const result = await getEmDashCollection("things", { status: "published", limit: 100 });
  if (!result.error && result.entries) {
    thing = result.entries.find((e) => {
      const data = e.data as unknown as Record<string, unknown>;
      return (e.id === slug || data.slug === slug) && data.kind === "page";
    });
    if (thing) cacheHint = result.cacheHint;
  }
}

if (!thing) return Astro.rewrite("/404");
if (cacheHint) Astro.cache.set(cacheHint);
if (Astro.url.searchParams.get("window") === "1") {
  Astro.response.headers.set("Cache-Control", "public, max-age=3600, stale-while-revalidate=86400");
}

const name = String(thing.data.name ?? "Page");
const title = `${name} | Kaio Barbosa`;
let thingIcon: string | undefined = undefined;
if (typeof thing.data.image === "string" && thing.data.image) {
  thingIcon = thing.data.image;
} else if (thing.data.image && typeof thing.data.image === "object") {
  const imgObj = thing.data.image as Record<string, unknown>;
  thingIcon = (typeof imgObj.src === "string" && imgObj.src) || (typeof imgObj.previewUrl === "string" && imgObj.previewUrl) || (typeof imgObj.url === "string" && imgObj.url) || undefined;
}
if (!thingIcon && thing.data.emoji) {
  thingIcon = String(thing.data.emoji);
}
const content = { collection: "things", id: thing.data.id ?? thing.id, slug: thing.id };
const body = thing.data.body;
const isWindow = Astro.url.searchParams.get("window") === "1";
---
<Portfolio embedded={isWindow} title={title} windowTitle={name} windowIcon={thingIcon || "📄"} restoreSlug={slug} content={content}>
  <article class="page-content">
    {!isWindow && <h1 {...thing.edit?.name}>{name}</h1>}
    {body && Array.isArray(body) && body.length > 0 ? (
      <PortableText value={body} components={{ type: { themeImage: ThemeImage, image: ContentImage } }} />
    ) : null}
  </article>
</Portfolio>
