---
import { getRequestContext } from 'emdash/request-context';
import { readThings, readThing } from '../../server/things/read';
import { pathFor } from '../../lib/things/model';
import { thingPage } from '../../server/things/page';
import ThingPage from '../../components/house/ThingPage.astro';
const thing = await readThing(Astro.params.id!, true);
if (!thing) return Astro.rewrite('/404');
const things = await readThings();
const context = getRequestContext();
if (!context?.preview && !context?.editMode) return Astro.redirect(pathFor(thing,things) || '/',302);
Astro.cache.set(false);
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex');
---
<ThingPage page={await thingPage(thing, things)} things={things} />
