---
import { readPost, postPage, thingPage } from '../../server/things/page';
import { getRequestContext } from 'emdash/request-context';
import { readThings } from '../../server/things/read';
import { pathFor } from '../../lib/things/model';
import ThingPage from '../../components/house/ThingPage.astro';
const post = await readPost(Astro.params.slug!);
if(!post)return Astro.rewrite('/404');
const things=await readThings('published');
const placement=things.find(t=>t.data.page_source==='post'&&t.postId===post.data.id);
const canonical=placement ? pathFor(placement,things) : `/blog/${post.id}`;
if(placement && !getRequestContext()?.preview && !getRequestContext()?.editMode) return Astro.redirect(canonical!+(Astro.url.searchParams.get('window')==='1'?'?window=1':''),302);
if (getRequestContext()?.editMode || getRequestContext()?.preview) Astro.cache.set(false);
---
<ThingPage page={placement ? await thingPage(placement, things, post) : postPage(post)} things={things} />
