---
import Portfolio from '../layouts/Portfolio.astro';
import { House } from '../components/house/House';
import { readThings, sceneThings } from '../server/things/read';
import { getRequestContext } from 'emdash/request-context';
const editMode = getRequestContext()?.editMode === true;
const things = sceneThings(await readThings());
// A Thing can change many folder routes and appearances; never cache an editor snapshot.
Astro.cache.set(false);
---
<Portfolio><House things={things} editMode={editMode} client:load /></Portfolio>
