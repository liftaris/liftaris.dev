---
import Portfolio from "../layouts/Portfolio.astro";
import { House } from "../components/house/House";
import { getEmDashCollection } from "emdash";
import { isImageUrl } from "../components/clump/model";
import type { ThingSpec, WritingPost } from "../components/house/folders";

function optimizeMediaUrl(url: string | null, targetWidth: number): string | null {
  if (!url) return null;
  if (url.startsWith("/_emdash/api/media/file/") && !url.endsWith(".gif") && !url.endsWith(".svg")) {
    return `/_image?href=${encodeURIComponent(url)}&w=${targetWidth}&f=webp`;
  }
  return url;
}

const posts: WritingPost[] = [];
let cursor: string | undefined;
do {
  const result = await getEmDashCollection("posts", { status: "published", orderBy: { date: "desc" }, limit: 100, cursor });
  if (result.error) throw result.error;
  Astro.cache.set(result.cacheHint);
  posts.push(...result.entries.map((post) => ({ id: post.data.id, slug: post.id, title: post.data.title, icon: post.data.icon })));
  cursor = result.nextCursor;
} while (cursor);

let things: ThingSpec[] | undefined;
try {
  const thingsResult = await getEmDashCollection("things", { status: "published", limit: 100 });
  if (!thingsResult.error && thingsResult.entries && thingsResult.entries.length > 0) {
    Astro.cache.set(thingsResult.cacheHint);
    things = thingsResult.entries.map((entry): ThingSpec => {
      const data = entry.data as Record<string, unknown>;
      const kind = (data.kind === "folder" || data.kind === "link" || data.kind === "action" || data.kind === "object" || data.kind === "page") ? data.kind : "object";
      const action = (data.action === "projects" || data.action === "experience" || data.action === "leave-gift") ? data.action : "none";
      const width = Number(data.width) || 60;
      const height = Number(data.height) || 60;
      const targetWidth = Math.max(Math.round(width * 2), 120);

      let imageUrl: string | null = null;
      if (typeof data.image === "string" && data.image) {
        imageUrl = data.image;
      } else if (data.image && typeof data.image === "object") {
        const imgObj = data.image as Record<string, unknown>;
        if (typeof imgObj.src === "string" && imgObj.src) {
          imageUrl = imgObj.src;
        } else if (typeof imgObj.previewUrl === "string" && imgObj.previewUrl) {
          imageUrl = imgObj.previewUrl;
        } else if (typeof imgObj.url === "string" && imgObj.url) {
          imageUrl = imgObj.url;
        } else if (typeof imgObj.id === "string" && imgObj.id) {
          const key = (imgObj.meta as Record<string, unknown> | undefined)?.storageKey || imgObj.id;
          imageUrl = `/_emdash/api/media/file/${key}`;
        }
      }
      const emojiVal = String(data.emoji ?? "📦");
      if (!imageUrl && isImageUrl(emojiVal)) {
        imageUrl = emojiVal;
      }
      imageUrl = optimizeMediaUrl(imageUrl, targetWidth);

      let bgImageUrl: string | null = null;
      if (typeof data.background_image === "string" && data.background_image) {
        bgImageUrl = data.background_image;
      } else if (data.background_image && typeof data.background_image === "object") {
        const bgObj = data.background_image as Record<string, unknown>;
        if (typeof bgObj.src === "string" && bgObj.src) {
          bgImageUrl = bgObj.src;
        } else if (typeof bgObj.previewUrl === "string" && bgObj.previewUrl) {
          bgImageUrl = bgObj.previewUrl;
        } else if (typeof bgObj.url === "string" && bgObj.url) {
          bgImageUrl = bgObj.url;
        } else if (typeof bgObj.id === "string" && bgObj.id) {
          const key = (bgObj.meta as Record<string, unknown> | undefined)?.storageKey || bgObj.id;
          bgImageUrl = `/_emdash/api/media/file/${key}`;
        }
      }
      bgImageUrl = optimizeMediaUrl(bgImageUrl, Math.max(Math.round(Math.max(width, height) * 2), 120));

      return {
        id: entry.id,
        name: String(data.name ?? ""),
        emoji: emojiVal,
        image: imageUrl,
        background_image: bgImageUrl,
        background_size: data.background_size ? String(data.background_size) : undefined,
        background_position: data.background_position ? String(data.background_position) : undefined,
        background_repeat: data.background_repeat ? String(data.background_repeat) : undefined,
        kind,
        desktop: Boolean(data.desktop),
        parent_id: data.parent_id ? String(data.parent_id) : null,
        action,
        href: data.href ? String(data.href) : (kind === "page" ? `/p/${encodeURIComponent(entry.id)}` : null),
        body: data.body,
        default_open: Boolean(data.default_open),
        anchor: Boolean(data.anchor),
        width,
        height,
        sort_order: Number(data.sort_order) || 0,
      };
    }).sort((a, b) => a.sort_order - b.sort_order);
  }
} catch {
  // Gracefully fallback to defaults if things collection not yet initialized
}
---
<Portfolio><House posts={posts} things={things} client:idle /></Portfolio>
