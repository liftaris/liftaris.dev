---
import Portfolio from '../layouts/Portfolio.astro';
import { House } from '../components/house/House';
import { readThings } from '../server/things/read';
import { sceneThings } from '../lib/things/scene';
import { getRequestContext } from 'emdash/request-context';
import { versionThings } from '../server/media';
const editMode = getRequestContext()?.editMode === true;
const things = await versionThings(sceneThings(await readThings()));
// A Thing can change many folder routes and appearances; never cache an editor snapshot.
if (editMode) Astro.cache.set(false);
---
<Portfolio home><House things={things} editMode={editMode} client:load /></Portfolio>
