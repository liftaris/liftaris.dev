---
import { readThings, readThingAtPath } from '../server/things/read';
import { getRequestContext } from 'emdash/request-context';
import { thingPage } from '../server/things/page';
import ThingPage from '../components/house/ThingPage.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const resolved = await readThingAtPath(path);
if (!resolved) return Astro.rewrite('/404');
const { thing } = resolved;
let { things } = resolved;
// Page windows need routing and Post visibility, not every folder's contents.
if (thing.data.kind === 'folder') things = await readThings('published');
if (getRequestContext()?.editMode || getRequestContext()?.preview) Astro.cache.set(false);
---
<ThingPage page={await thingPage(thing, things)} things={things} />
