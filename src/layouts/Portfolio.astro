---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/manrope";
import "@fontsource/young-serif";
import "../styles/global.css";

interface Props { title?: string; embedded?: boolean; content?: { collection: string; id: string; slug?: string | null } }
const { title = "Kaio Barbosa", content, embedded = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const onBlog = pathname.startsWith("/blog/");
const isHome = pathname === "/";
const page = createPublicPageContext({ Astro, kind: content ? "content" : "custom", title,
  description: "Software engineer building BazaarGhost and Herm TUI.", content,
  canonical: new URL(pathname, Astro.site).href, siteName: "Kaio Barbosa" });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {embedded && <base target="_top" />}
    <EmDashHead page={page} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class:list={{ "embedded-post": embedded }}>
    <EmDashBodyStart page={page} />
    {!embedded ? (
      <div class="site-window" data-home={isHome}>
        <header class="site-window-header">
          <div class="site-window-drag" />
          <div class="site-window-controls">
            {isHome ? (
              <button
                type="button"
                class="site-window-close"
                id="site-window-close-btn"
                aria-label="Close window"
                onclick="window.dispatchEvent(new CustomEvent('liftaris:collapse-desktop'))"
              >
                ×
              </button>
            ) : (
              <a href="/" class="site-window-close" aria-label="Close to homepage">
                ×
              </a>
            )}
          </div>
        </header>
        <div class="site-window-body">
          <div class:list={["shell", { onBlog, onHome: isHome }]}>
            <div class="identity">
              <a class="name" href="/" aria-label="Home"><h1><span>Kaio</span><span>Barbosa</span></h1></a>
            </div>
            <section class="stageContent"><slot /></section>
          </div>
        </div>
      </div>
    ) : (
      <div class:list={["shell", { onBlog, onHome: isHome }]}>
        <section class="stageContent"><slot /></section>
      </div>
    )}
    <EmDashBodyEnd page={page} />
  </body>
</html>
