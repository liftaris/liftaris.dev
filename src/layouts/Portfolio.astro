---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/manrope";
import "@fontsource/young-serif";
import "../styles/global.css";
import { isImageUrl } from "../components/clump/model";

interface Props {
  title?: string;
  windowTitle?: string;
  windowIcon?: string;
  restoreSlug?: string;
  embedded?: boolean;
  content?: { collection: string; id: string; slug?: string | null };
}
const {
  title = "Kaio Barbosa",
  windowTitle,
  windowIcon,
  restoreSlug,
  content,
  embedded = false,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const onBlog = pathname.startsWith("/blog/");
const isHome = pathname === "/";

let displayTitle = windowTitle;
let displayIcon = windowIcon;
let actualRestoreSlug = restoreSlug;

if (!displayTitle && !isHome) {
  if (pathname === "/projects") {
    displayTitle = "Projects";
  } else if (pathname === "/experience") {
    displayTitle = "Experience";
  } else if (pathname === "/github") {
    displayTitle = "GitHub";
  } else {
    displayTitle = title.replace(/\s*\|\s*Kaio Barbosa\s*$/, "");
  }
}

if (!displayIcon && !isHome) {
  if (pathname === "/projects") {
    displayIcon = "🖥️";
  } else if (pathname === "/experience") {
    displayIcon = "💼";
  } else if (pathname === "/github") {
    displayIcon = "/github.svg";
  } else if (onBlog) {
    displayIcon = "📝";
  }
}

if (!actualRestoreSlug && !isHome) {
  if (pathname === "/projects") actualRestoreSlug = "projects";
  else if (pathname === "/experience") actualRestoreSlug = "experience";
  else if (pathname === "/github") actualRestoreSlug = "github";
  else if (onBlog) actualRestoreSlug = pathname.replace(/^\/blog\//, "").split("?")[0];
  else if (pathname.startsWith("/p/")) actualRestoreSlug = pathname.replace(/^\/p\//, "").split("?")[0];
  else actualRestoreSlug = pathname.replace(/^\//, "").split("?")[0];
}

const isIconImage = displayIcon ? isImageUrl(displayIcon) : false;
const page = createPublicPageContext({ Astro, kind: content ? "content" : "custom", title,
  description: "Software engineer building BazaarGhost and Herm TUI.", content,
  canonical: new URL(pathname, Astro.site).href, siteName: "Kaio Barbosa" });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {embedded && <base target="_top" />}
    <EmDashHead page={page} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class:list={{ "embedded-post": embedded }}>
    <EmDashBodyStart page={page} />
    {!embedded ? (
      <div class="site-window" class:list={{ "object-window": !isHome }} data-home={isHome}>
        <header class="site-window-header">
          <div class="site-window-drag">
            {!isHome && (
              <>
                {displayIcon && (
                  <span class="site-window-icon">
                    {isIconImage ? (
                      <img src={displayIcon} alt="" class="site-window-image" />
                    ) : (
                      displayIcon
                    )}
                  </span>
                )}
                {displayTitle && (
                  <div class="site-window-handle">
                    <span class="site-window-title">{displayTitle}</span>
                  </div>
                )}
              </>
            )}
          </div>
          <div class="site-window-controls">
            {isHome ? (
              <button
                type="button"
                class="site-window-close"
                id="site-window-close-btn"
                aria-label="Close window"
                onclick="window.dispatchEvent(new CustomEvent('liftaris:collapse-desktop'))"
              >
                ×
              </button>
            ) : (
              <>
                <a
                  href={`/?restore=${encodeURIComponent(actualRestoreSlug || "")}`}
                  class="site-window-max"
                  aria-label="Restore window"
                  title="Restore window"
                >
                  <span class="wb-restore-square" aria-hidden="true" />
                </a>
                <a
                  href="/"
                  class="site-window-close"
                  aria-label="Close to homepage"
                  title="Close window"
                >
                  ×
                </a>
              </>
            )}
          </div>
        </header>
        <div class="site-window-body">
          {isHome ? (
            <div class="shell onHome">
              <div class="identity">
                <a class="name" href="/" aria-label="Home"><h1><span>Kaio</span><span>Barbosa</span></h1></a>
              </div>
              <section class="stageContent"><slot /></section>
            </div>
          ) : (
            <div class="object-window-content">
              <slot />
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="object-window-content">
        <slot />
      </div>
    )}
    <script>
      document.querySelectorAll<HTMLAnchorElement>(".site-window-max, .site-window-close").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const href = btn.getAttribute("href");
          if (!href) return;
          if (typeof document !== "undefined" && "startViewTransition" in document && typeof (document as unknown as { startViewTransition?: (cb: () => void) => unknown }).startViewTransition === "function") {
            e.preventDefault();
            (document as unknown as { startViewTransition: (cb: () => void) => unknown }).startViewTransition(() => {
              window.location.href = href;
            });
          }
        });
      });
    </script>
    <EmDashBodyEnd page={page} />
  </body>
</html>
