---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import geistMonoLatinUrl from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import youngSerifLatinUrl from "@fontsource/young-serif/files/young-serif-latin-400-normal.woff2?url";
import "@fontsource-variable/geist-mono";
import "@fontsource/young-serif";
import "../styles/global.css";
import { isImageUrl } from "../components/clump/model";

interface Props {
  title?: string;
  windowTitle?: string;
  windowIcon?: string;
  restoreSlug?: string;
  embedded?: boolean;
  content?: { collection: string; id: string; slug?: string | null };
}
const {
  title = "Kaio Barbosa",
  windowTitle,
  windowIcon,
  restoreSlug,
  content,
  embedded = false,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const onBlog = pathname.startsWith("/blog/");
const isHome = pathname === "/";
const isBlogPost = onBlog || content?.collection === "posts";
const isWritingPage = pathname.startsWith("/p/") || (content?.collection === "things" && Boolean(content?.id));
const isUnconstrained = isBlogPost || isWritingPage;

let displayTitle = windowTitle;
let displayIcon = windowIcon;
let actualRestoreSlug = restoreSlug;

if (!displayTitle && !isHome) {
  if (pathname === "/projects") {
    displayTitle = "Projects";
  } else if (pathname === "/experience") {
    displayTitle = "Experience";
  } else if (pathname === "/github") {
    displayTitle = "GitHub";
  } else {
    displayTitle = title.replace(/\s*\|\s*Kaio Barbosa\s*$/, "");
  }
}

if (!displayIcon && !isHome) {
  if (pathname === "/projects") {
    displayIcon = "🖥️";
  } else if (pathname === "/experience") {
    displayIcon = "💼";
  } else if (pathname === "/github") {
    displayIcon = "/github.svg";
  } else if (onBlog) {
    displayIcon = "📝";
  }
}

if (!actualRestoreSlug && !isHome) {
  if (pathname === "/projects") actualRestoreSlug = "projects";
  else if (pathname === "/experience") actualRestoreSlug = "experience";
  else if (pathname === "/github") actualRestoreSlug = "github";
  else if (onBlog) actualRestoreSlug = pathname.replace(/^\/blog\//, "").split("?")[0];
  else if (pathname.startsWith("/p/")) actualRestoreSlug = pathname.replace(/^\/p\//, "").split("?")[0];
  else actualRestoreSlug = pathname.replace(/^\//, "").split("?")[0];
}

const isIconImage = displayIcon ? isImageUrl(displayIcon) : false;
const page = createPublicPageContext({ Astro, kind: content ? "content" : "custom", title,
  description: "Software engineer building BazaarGhost and Herm TUI.", content,
  canonical: new URL(pathname, Astro.site).href, siteName: "Kaio Barbosa" });
---
<!doctype html>
<html lang="en" class:list={{ "on-home": isHome }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={youngSerifLatinUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={geistMonoLatinUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    {!embedded && <link rel="preload" href="/stars.webp" as="image" type="image/webp" />}
    {embedded && <base target="_top" />}
    <EmDashHead page={page} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class={embedded ? (isHome ? "embedded-post on-home" : "embedded-post") : (isHome ? "on-home" : undefined)}>
    <EmDashBodyStart page={page} />
    {!embedded ? (
      <div
        data-app="WindowList"
        class="desktop-viewport flex size-full min-h-dvh justify-center p-2.5 md:p-4"
        class:list={[
          isHome ? "items-center" : "items-start",
        ]}
      >
        <div
          data-app="AppWindow"
          class="site-window"
          class:list={[
            "@container w-full md:max-w-[720px] lg:max-w-[960px] xl:max-w-[1200px] 2xl:max-w-[1360px]",
            isUnconstrained
              ? "min-h-[calc(100dvh-20px)] md:min-h-[calc(100dvh-32px)] h-auto"
              : "h-[calc(100dvh-20px)] md:h-[calc(100dvh-32px)]",
            isHome ? "max-h-[1200px]" : undefined,
            { "object-window": !isHome },
          ]}
          data-home={isHome ? "true" : undefined}
          data-unconstrained={isUnconstrained ? "true" : undefined}
        >
        <header class="site-window-header">
          <div class="site-window-drag">
            {!isHome && (
              <>
                {displayIcon && (
                  <span class="site-window-icon">
                    {isIconImage ? (
                      <img src={displayIcon} alt="" class="site-window-image" />
                    ) : (
                      displayIcon
                    )}
                  </span>
                )}
                {displayTitle && (
                  <div class="site-window-handle">
                    <span class="site-window-title">{displayTitle}</span>
                  </div>
                )}
              </>
            )}
          </div>
          <div class="site-window-controls">
            {isHome ? (
              <button
                type="button"
                class="site-window-close"
                id="site-window-close-btn"
                aria-label="Close window"
                onclick="window.dispatchEvent(new CustomEvent('liftaris:collapse-desktop'))"
              >
                ×
              </button>
            ) : (
              <>
                <a
                  href={`/?restore=${encodeURIComponent(actualRestoreSlug || "")}`}
                  class="site-window-max"
                  aria-label="Restore window"
                  title="Restore window"
                >
                  <span class="wb-restore-square" aria-hidden="true" />
                </a>
                <a
                  href="/"
                  class="site-window-close"
                  aria-label="Close to homepage"
                  title="Close window"
                >
                  ×
                </a>
              </>
            )}
          </div>
        </header>
        <div class="site-window-body">
          {isHome ? (
            <div class="shell onHome">
              <div class="identity">
                <span class="name"><h1><span>Kaio</span><span>Barbosa</span></h1></span>
              </div>
              <section class="stageContent"><slot /></section>
            </div>
          ) : (
            <div class="object-window-content">
              <slot />
            </div>
          )}
        </div>
      </div>
    </div>
  ) : (
      <div class="object-window-content">
        <slot />
      </div>
    )}
    <script>
      document.querySelectorAll<HTMLAnchorElement>(".site-window-max, .site-window-close").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const href = btn.getAttribute("href");
          if (!href) return;
          if (typeof document !== "undefined" && "startViewTransition" in document && typeof (document as unknown as { startViewTransition?: (cb: () => void) => unknown }).startViewTransition === "function") {
            e.preventDefault();
            (document as unknown as { startViewTransition: (cb: () => void) => unknown }).startViewTransition(() => {
              window.location.href = href;
            });
          }
        });
      });
    </script>
    <EmDashBodyEnd page={page} />
  </body>
</html>
