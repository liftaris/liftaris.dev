---
import { PortableText } from 'emdash/ui';
import type { PortableTextBlock } from '@portabletext/types';
import { getRequestContext } from 'emdash/request-context';
import Portfolio from '../../layouts/Portfolio.astro';
import ThemeImage from '../ThemeImage.astro';
import ContentImage from '../ContentImage.astro';
import { Stage } from '../../../components/Stage';
import { GitHubViewer } from './GitHubViewer';
import { House } from './House';
import { sceneThings } from '../../lib/things/scene';
import { mediaUrl, pathFor, type ThingRecord } from '../../lib/things/model';
interface Props { thing: ThingRecord; things: ThingRecord[] }
const { thing, things } = Astro.props;
const embedded = Astro.url.searchParams.get('window') === '1';
const icon = thing.data.icon_type === 'image' ? mediaUrl(thing.data.image) : thing.data.emoji;
let canonical: string | undefined;
try { canonical = pathFor(thing, things) ?? undefined; } catch { /* Incomplete drafts are still previewable. */ }
---
<Portfolio embedded={embedded} title={`${thing.data.name} | Kaio Barbosa`} windowTitle={thing.data.name} windowIcon={icon || '📄'} restoreSlug={thing.id} canonicalPath={canonical} content={{collection:'things',id:thing.id,slug:thing.slug}}>
  {thing.data.kind === 'folder' ? <House things={sceneThings(things)} initialFolderId={thing.id} editMode={Boolean(getRequestContext()?.editMode)} client:load /> :
  thing.data.page_source === 'projects' || thing.data.page_source === 'experience' ? <Stage view={thing.data.page_source} client:load /> :
  thing.data.page_source === 'github' ? <GitHubViewer client:load /> :
  <article class="page-content">
    {!embedded && <h1>{thing.data.name}</h1>}
    {thing.data.date && <p class="meta">{new Date(thing.data.date).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</p>}
    <PortableText value={thing.data.body as PortableTextBlock[]} components={{type:{themeImage:ThemeImage,image:ContentImage}}} />
  </article>}
</Portfolio>
