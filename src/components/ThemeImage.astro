---
import { imageUrl, imageSources } from "../lib/images";
interface ThemeImageProps {
  lightSrc: string; darkSrc: string; alt?: string; width?: number; height?: number;
}
interface Props { node: ThemeImageProps }
const { node } = Astro.props;
const lightSrc = node.lightSrc;
const darkSrc = node.darkSrc;
const alt = node.alt || "";
const width = node.width;
const height = node.height;
---
<picture>
  <source media="(prefers-color-scheme: dark)" srcset={imageSources(darkSrc, 960) ?? darkSrc} />
  <img src={imageUrl(lightSrc, 960)} srcset={imageSources(lightSrc, 960)} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
</picture>
