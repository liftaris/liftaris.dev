---
// Landing page animated canvas background (DotForge Dithered Swirl)
---
<canvas id="landing-canvas-background" class="landing-canvas-background" aria-hidden="true"></canvas>

<script>
  (function () {
    const c = document.getElementById("landing-canvas-background") as HTMLCanvasElement | null;
    if (!c) return;
    const ctx = c.getContext("2d");
    if (!ctx) return;
    const context = ctx;

    c.width = 800;
    c.height = 800;
    const W = 800, H = 800;
    const fg = [0, 136, 255], bg = [0, 8, 22], ac = [0, 204, 255];
    const px = 2, thr = 128 / 255, spr = 50 / 100;
    const acMix = 0 / 100;
    const acMode = "blend" as "blend" | "hard" | "pattern";
    const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);

    const pattern = (() => {
      const B = [
        [0, 8, 2, 10],
        [12, 4, 14, 6],
        [3, 11, 1, 9],
        [15, 7, 13, 5],
      ].map((r) => r.map((v) => v / 16));
      return (x: number, y: number) => B[y & 3][x & 3];
    })();

    const effectFn = (buf: Float32Array, w: number, h: number, t: number, intensity: number, scale: number) => {
      const cx = w / 2, cy = h / 2;
      const maxR = Math.sqrt(cx * cx + cy * cy);
      const twist = (intensity / 50) * 4;
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const dx = x - cx, dy = y - cy;
          const dist = Math.sqrt(dx * dx + dy * dy) / maxR;
          const angle = Math.atan2(dy, dx) + dist * twist * Math.sin(t * 2);
          const v = (Math.sin(angle * scale + t * 3) * 0.5 + 0.5) * (1 - dist * 0.3);
          buf[y * w + x] = clamp01(v);
        }
      }
    };

    const buf = new Float32Array(W * H);
    let t = 0;
    const img = ctx.createImageData(W, H);
    const d = img.data;

    let animId: number;
    function draw() {
      t += 0.016 * 1;
      effectFn(buf, W, H, t, 50, 4);
      const halfZone = acMix * 0.45, acLo = 0.5 - halfZone, acHi = 0.5 + halfZone;
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const idx = y * W + x, gray = buf[idx];
          const qx = Math.floor(x / px), qy = Math.floor(y / px);
          const pv = pattern(qx, qy);
          const dithered = (gray + (pv - 0.5) * spr) > thr ? 1 : 0;
          let r: number, g: number, b: number;
          if (gray < 0) {
            r = ac[0]; g = ac[1]; b = ac[2];
          } else if (acMix > 0.01 && gray >= acLo && gray <= acHi) {
            if (acMode === "hard") {
              r = ac[0]; g = ac[1]; b = ac[2];
            } else if (acMode === "pattern") {
              if (dithered) { r = ac[0]; g = ac[1]; b = ac[2]; } else { r = bg[0]; g = bg[1]; b = bg[2]; }
            } else {
              const dist = Math.abs(gray - 0.5);
              const ef = halfZone > 0.01 ? 1 - dist / halfZone : 1;
              const bl = ef * ef;
              if (dithered) {
                r = fg[0] + (ac[0] - fg[0]) * bl;
                g = fg[1] + (ac[1] - fg[1]) * bl;
                b = fg[2] + (ac[2] - fg[2]) * bl;
              } else {
                r = bg[0] + (ac[0] - bg[0]) * bl;
                g = bg[1] + (ac[1] - bg[1]) * bl;
                b = bg[2] + (ac[2] - bg[2]) * bl;
              }
            }
          } else {
            const col = dithered ? fg : bg;
            r = col[0]; g = col[1]; b = col[2];
          }
          const p = idx * 4;
          d[p] = r;
          d[p + 1] = g;
          d[p + 2] = b;
          d[p + 3] = 255;
        }
      }
      context.putImageData(img, 0, 0);
      animId = requestAnimationFrame(draw);
    }
    draw();

    document.addEventListener("astro:before-swap", () => {
      cancelAnimationFrame(animId);
    }, { once: true });
  })();
</script>

<style>
  .landing-canvas-background {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    width: 100dvw;
    height: 100dvh;
    object-fit: cover;
    image-rendering: pixelated;
    z-index: 0;
    pointer-events: none;
    background: #000816;
  }
</style>
