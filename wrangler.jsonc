{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liftaris-dev",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "main": "./src/worker.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "liftaris.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.liftaris.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liftaris-emdash",
      "database_id": "0e886ca8-384e-4090-8035-c187268c7da7"
    },
    {
      "binding": "VISITOR_DB",
      "database_name": "liftaris-visitors",
      // Local-only sentinel. Provision a separate production D1 database and
      // replace this ID before deploying this Wrangler-owned Worker.
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/visitor-auth"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HOUSE", "class_name": "House" }
    ]
  },
  "migrations": [
    { "tag": "house-v1", "new_sqlite_classes": ["House"] }
  ],
  "vars": {
    "HOUSE_OWNER_ID": ""
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "liftaris-emdash-media"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "8bf01aa04a0d44499c86e377038ad892"
    }
  ],
  "previews": {
    "vars": {
      "HOUSE_OWNER_ID": ""
    },
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "c2d847173c624a3e816ed26dceb8504c"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "liftaris-preview-cms",
        "database_id": "98b72d63-316e-4f01-bde4-4e42365cf07f"
      },
      {
        "binding": "VISITOR_DB",
        "database_name": "liftaris-preview-visitors",
        "database_id": "c9850c71-4143-4490-ab8d-28d487c4fb00",
        "migrations_dir": "migrations/visitor-auth"
      }
    ],
    "r2_buckets": [
      {
        "binding": "MEDIA",
        "bucket_name": "liftaris-preview-media"
      }
    ],
    "durable_objects": {
      "bindings": [
        { "name": "HOUSE", "class_name": "House" }
      ]
    }
  },
  "secrets": {
    "required": [
      "EMDASH_SETUP_KEY",
      "VISITOR_AUTH_SECRET",
      "JEV_API_KEY"
    ]
  }
}
