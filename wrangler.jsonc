{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liftaris-dev",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "main": "./src/worker.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "liftaris.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.liftaris.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liftaris-emdash",
      "database_id": "0e886ca8-384e-4090-8035-c187268c7da7"
    }
  ],
  // Applied namespace history. Keep the inert House export; it is not used by the app.
  // A deleted_classes migration would delete remote storage.
  "migrations": [
    { "tag": "house-v1", "new_sqlite_classes": ["House"] }
  ],
  "vars": {
    "HOUSE_OWNER_ID": "01M366VZ20X87M0WMW2Y846Z0Y"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "liftaris-emdash-media"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "8bf01aa04a0d44499c86e377038ad892"
    }
  ],
  "previews": {
    // Preview deployments replace env. Preserve server-side secrets explicitly;
    // top-level secrets.required only drives local validation and type generation.
    "unsafe": {
      "bindings": [
        { "name": "EMDASH_SETUP_KEY", "type": "inherit" },
        { "name": "JEV_API_KEY", "type": "inherit" }
      ]
    },
    "vars": {
      // Owner registered in the isolated preview CMS, not production.
      "HOUSE_OWNER_ID": "01M3D50BEQJSREDCCRJK91R999"
    },
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "d40889cd503f4bd4912c6de7aafd5394"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        // Preview gifts, native users and CMS content never touch production.
        "database_name": "liftaris-emdash-preview",
        "database_id": "a5e64636-afe8-44f9-87e6-5055554edda9"
      }
    ],
    "r2_buckets": [
      {
        "binding": "MEDIA",
        "bucket_name": "liftaris-emdash-media-preview"
      }
    ]
  },
  "secrets": {
    "required": [
      "EMDASH_SETUP_KEY",
      "JEV_API_KEY"
    ]
  }
}
