{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "liftaris-dev",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "main": "./src/worker.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "liftaris.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.liftaris.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liftaris-emdash",
      "database_id": "0e886ca8-384e-4090-8035-c187268c7da7"
    }
  ],
  // Historical namespace only: keep the inert House export and migration.
  // No runtime binding or deleted_classes migration; legacy data is not migrated.
  // See docs/legacy-gift-retirement.md before changing this history.
  "migrations": [
    { "tag": "house-v1", "new_sqlite_classes": ["House"] }
  ],
  "vars": {
    "HOUSE_OWNER_ID": "01M366VZ20X87M0WMW2Y846Z0Y"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "liftaris-emdash-media"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "8bf01aa04a0d44499c86e377038ad892"
    }
  ],
  "previews": {
    // Preview deployments replace env. Preserve server-side secrets explicitly;
    // top-level secrets.required only drives local validation and type generation.
    "unsafe": {
      "bindings": [
        { "name": "EMDASH_SETUP_KEY", "type": "inherit" },
        { "name": "JEV_API_KEY", "type": "inherit" }
      ]
    },
    "vars": {
      "HOUSE_OWNER_ID": "01M366VZ20X87M0WMW2Y846Z0Y"
    },
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "c2d847173c624a3e816ed26dceb8504c"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        // One CMS and media library serve production and branch previews.
        "database_name": "liftaris-emdash",
        "database_id": "0e886ca8-384e-4090-8035-c187268c7da7"
      }
    ],
    "r2_buckets": [
      {
        "binding": "MEDIA",
        "bucket_name": "liftaris-emdash-media"
      }
    ]
  },
  "secrets": {
    "required": [
      "EMDASH_SETUP_KEY",
      "JEV_API_KEY"
    ]
  }
}
