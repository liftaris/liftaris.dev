{
  "$schema": "https://unpkg.com/knip@6.23.0/schema.json",
  "project": [
    "src/**/*.{astro,ts,tsx}",
    "components/**/*.{ts,tsx}",
    "data/**/*.ts"
  ],
  "entry": [
    "src/pages/**/*.{astro,ts}",
    "src/plugins/*.ts",
    "{src,components,data}/**/*.test.{ts,tsx}"
  ],
  "ignore": [
    "**/*.config.{js,mjs,ts}"
  ],
  "ignoreDependencies": [
    "shadcn",
    "tw-animate-css",
    "tailwindcss",
    "cloudflare"
  ],
  "ignoreBinaries": [],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "duplicates": "warn"
  }
}
