{
  "$schema": "https://unpkg.com/knip@6.23.0/schema.json",
  "project": [
    "src/**/*.{astro,ts,tsx,css}",
    "components/**/*.{ts,tsx}",
    "data/**/*.ts",
    "tools/**/*.ts"
  ],
  "entry": [
    "src/pages/**/*.{astro,ts}",
    "src/live.config.ts",
    "src/plugins/things.ts",
    "src/plugins/gifts.ts",
    "src/plugins/theme-image.ts",
    "src/plugins/things/admin.tsx"
  ],
  "ignoreDependencies": [
    "cloudflare"
  ],
  "ignoreBinaries": [],
  "ignoreExportsUsedInFile": false,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "duplicates": "error"
  }
}
