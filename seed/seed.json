{
  "version": "1",
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "urlPattern": "/blog/{slug}",
      "dateField": "date",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "scheduling",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "icon",
          "label": "Icon",
          "type": "string",
          "required": true,
          "defaultValue": "\ud83d\udcc4"
        },
        {
          "slug": "date",
          "label": "Date",
          "type": "datetime",
          "required": true
        },
        {
          "slug": "content",
          "label": "Body",
          "type": "portableText",
          "searchable": true
        }
      ],
      "hidden": false
    },
    {
      "slug": "things",
      "label": "Things",
      "labelSingular": "Thing",
      "icon": "shapes",
      "supports": [
        "preview",
        "search",
        "seo"
      ],
      "editLocking": true,
      "routable": true,
      "urlPattern": "/things-preview/{id}",
      "commentsEnabled": true,
      "admin": {
        "listColumns": [
          "name",
          "kind",
          "desktop"
        ]
      },
      "fields": [
        {
          "slug": "name",
          "label": "Name",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "kind",
          "label": "Kind",
          "type": "select",
          "defaultValue": "folder",
          "validation": {
            "options": [
              "page",
              "folder"
            ]
          }
        },
        {
          "slug": "icon_type",
          "label": "Icon type",
          "type": "select",
          "defaultValue": "emoji",
          "validation": {
            "options": [
              "emoji",
              "image"
            ]
          }
        },
        {
          "slug": "emoji",
          "label": "Emoji",
          "type": "string",
          "defaultValue": "\ud83d\udce6"
        },
        {
          "slug": "image",
          "label": "Icon image",
          "type": "image"
        },
        {
          "slug": "width",
          "label": "Icon width",
          "type": "integer",
          "defaultValue": 60,
          "validation": {
            "min": 24,
            "max": 240
          }
        },
        {
          "slug": "height",
          "label": "Icon height",
          "type": "integer",
          "defaultValue": 60,
          "validation": {
            "min": 24,
            "max": 240
          }
        },
        {
          "slug": "window_width",
          "label": "Initial window width",
          "type": "number",
          "defaultValue": 480,
          "validation": {
            "min": 180,
            "max": 2560
          }
        },
        {
          "slug": "window_height",
          "label": "Initial window height",
          "type": "number",
          "defaultValue": 380,
          "validation": {
            "min": 100,
            "max": 1800
          }
        },
        {
          "slug": "window_x",
          "label": "Initial window X (0\u20131)",
          "type": "number",
          "validation": {
            "min": 0,
            "max": 1
          }
        },
        {
          "slug": "window_y",
          "label": "Initial window Y (0\u20131)",
          "type": "number",
          "validation": {
            "min": 0,
            "max": 1
          }
        },
        {
          "slug": "desktop",
          "label": "Show on homepage",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "slug": "default_open",
          "label": "Open on arrival",
          "type": "boolean",
          "defaultValue": false
        },
        {
          "slug": "sort_order",
          "label": "Homepage order",
          "type": "integer",
          "defaultValue": 0,
          "validation": {
            "min": 0,
            "max": 100000
          }
        },
        {
          "slug": "spawn_x",
          "label": "Starting X",
          "type": "number",
          "defaultValue": 0.5,
          "validation": {
            "min": 0,
            "max": 1
          }
        },
        {
          "slug": "spawn_y",
          "label": "Starting Y",
          "type": "number",
          "defaultValue": 0.5,
          "validation": {
            "min": 0,
            "max": 1
          }
        },
        {
          "slug": "contents",
          "label": "Folder contents",
          "type": "reference",
          "validation": {
            "targetCollection": "things",
            "multiple": true
          }
        },
        {
          "slug": "primary_folder",
          "label": "Primary folder (URL)",
          "type": "reference",
          "validation": {
            "targetCollection": "things",
            "multiple": false
          }
        },
        {
          "slug": "path_override",
          "label": "Custom site path",
          "type": "string"
        },
        {
          "slug": "page_source",
          "label": "Page source",
          "type": "select",
          "defaultValue": "content",
          "validation": {
            "options": [
              "content",
              "post",
              "projects",
              "experience",
              "github",
              "guestbook"
            ]
          }
        },
        {
          "slug": "post",
          "label": "Post",
          "type": "reference",
          "validation": {
            "targetCollection": "posts",
            "multiple": false
          }
        },
        {
          "slug": "body",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "background_image",
          "label": "Folder background",
          "type": "image"
        },
        {
          "slug": "background_size",
          "label": "Background fit",
          "type": "select",
          "defaultValue": "cover",
          "validation": {
            "options": [
              "cover",
              "contain",
              "auto",
              "100% 100%",
              "50%",
              "75%",
              "150%",
              "200%"
            ]
          }
        },
        {
          "slug": "background_position",
          "label": "Background position",
          "type": "select",
          "defaultValue": "center",
          "validation": {
            "options": [
              "center",
              "top",
              "bottom",
              "left",
              "right",
              "top left",
              "top right",
              "bottom left",
              "bottom right"
            ]
          }
        },
        {
          "slug": "background_repeat",
          "label": "Background repeat",
          "type": "select",
          "defaultValue": "no-repeat",
          "validation": {
            "options": [
              "no-repeat",
              "repeat",
              "repeat-x",
              "repeat-y",
              "round",
              "space"
            ]
          }
        }
      ]
    }
  ]
}
