{
  "name": "liftaris.dev",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run types:worker && astro dev",
    "build": "bun run types:worker && astro build",
    "start": "wrangler dev",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun tools/deploy.ts",
    "deploy:check": "bun tools/deploy.ts --check",
    "perf:measure": "bun tools/performance.ts",
    "perf:warm": "bun tools/performance.ts --warm",
    "media:migrate-inline": "bun tools/migrate-inline-images.ts",
    "types:worker": "wrangler types --strict-vars false",
    "lint": "eslint",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "typecheck": "bun run types:worker && astro check && bun run typecheck:tools",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "cms": "emdash",
    "emoji:generate": "bun tools/generate-emoji-catalog.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "7.0.1",
    "@cloudflare/kumo": "2.6.0",
    "@emdash-cms/admin": "1.2.0",
    "@emdash-cms/cloudflare": "1.2.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-emoji": "^5.3.2",
    "@fontsource/young-serif": "^5.3.0",
    "@unpic/placeholder": "^0.1.2",
    "astro": "^7.3.8",
    "effect": "4.0.2",
    "emdash": "1.2.0",
    "kysely": "0.29.6",
    "matter-js": "^0.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "winbox": "0.2.82"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/winbox": "0.2.6",
    "emojibase-data": "17.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "knip": "^6.40.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.149.0"
  },
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "patchedDependencies": {
    "@emdash-cms/admin@1.2.0": "patches/@emdash-cms%2Fadmin@1.2.0.patch"
  }
}
