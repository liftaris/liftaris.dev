{
  "name": "liftaris.dev",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "bun run types:worker && astro dev",
    "build": "bun run types:worker && astro build",
    "start": "wrangler dev",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "types:worker": "wrangler types --strict-vars false",
    "lint": "eslint",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "typecheck": "bun run types:worker && astro check",
    "cms": "emdash",
    "emoji:generate": "bun tools/generate-emoji-catalog.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "7.0.0",
    "@cloudflare/kumo": "2.6.0",
    "@emdash-cms/admin": "1.0.1",
    "@emdash-cms/cloudflare": "1.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-emoji": "^5.3.2",
    "@fontsource/young-serif": "^5.3.0",
    "astro": "^7.3.5",
    "effect": "4.0.0-rc.117",
    "emdash": "1.0.1",
    "kysely": "0.29.6",
    "matter-js": "^0.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "winbox": "0.2.82"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/winbox": "0.2.6",
    "emojibase-data": "17.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "knip": "^6.38.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.143.0"
  },
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "patchedDependencies": {
    "@emdash-cms/admin@1.0.1": "patches/@emdash-cms%2Fadmin@1.0.1.patch"
  }
}
