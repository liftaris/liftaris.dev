{
  "name": "liftaris.dev",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verify-preview-config.mjs",
    "start": "wrangler dev",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "types:worker": "wrangler types --strict-vars false",
    "db:visitor:local": "wrangler d1 migrations apply VISITOR_DB --local",
    "db:visitor:preview": "wrangler d1 migrations apply VISITOR_DB --remote --config wrangler.preview-migrations.json",
    "infra:plan": "astro build && alchemy plan --stage preview",
    "infra:deploy": "astro build && alchemy deploy --stage preview",
    "lint": "eslint",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "typecheck": "astro check",
    "cms": "emdash",
    "migrate:posts": "node scripts/migrate-posts.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^6.0.5",
    "@emdash-cms/cloudflare": "0.38.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@typesafe-ai/sdk": "0.6.0",
    "astro": "^7.3.4",
    "better-auth": "1.7.5",
    "effect": "4.0.0-rc.117",
    "emdash": "0.38.0",
    "gray-matter": "^4.0.3",
    "matter-js": "^0.20.0",
    "partyserver": "0.5.10",
    "partysocket": "1.3.0",
    "partysync": "2.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.12.0",
    "tw-animate-css": "^1.4.0",
    "winbox": "0.2.82"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/winbox": "0.2.6",
    "alchemy": "2.0.0-beta.79",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.2.1",
    "knip": "^6.23.0",
    "miniflare": "5.20260918.0-alpha",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "unified": "^11.0.5",
    "wrangler": "^4.135.0"
  },
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  }
}
