{
  "name": "liftaris.dev",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run types:worker && cf dev",
    "build": "bun run types:worker && cf build",
    "start": "astro preview",
    "preview": "bun run build && astro preview",
    "deploy": "bun run build && cf deploy --prebuilt --mode production",
    "perf:measure": "bun tools/performance.ts",
    "perf:warm": "bun tools/performance.ts --warm",
    "media:migrate-inline": "bun tools/migrate-inline-images.ts",
    "types:worker": "cf workers types",
    "lint": "eslint",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "typecheck": "bun run types:worker && astro check && bun run typecheck:tools",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "cms": "emdash",
    "emoji:generate": "bun tools/generate-emoji-catalog.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.1",
    "@astrojs/react": "7.0.1",
    "@cloudflare/kumo": "2.14.0",
    "@emdash-cms/admin": "1.2.0",
    "@emdash-cms/cloudflare": "1.2.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-emoji": "^5.3.2",
    "@fontsource/young-serif": "^5.3.0",
    "@unpic/placeholder": "^0.1.2",
    "astro": "7.4.0-beta.1",
    "effect": "4.0.4",
    "emdash": "1.2.0",
    "kysely": "0.29.6",
    "matter-js": "^0.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "winbox": "0.2.82"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/winbox": "0.2.6",
    "cf": "^1.0.0-beta.17",
    "emojibase-data": "17.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "knip": "^6.41.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.151.0"
  },
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "patchedDependencies": {
    "@emdash-cms/admin@1.2.0": "patches/@emdash-cms%2Fadmin@1.2.0.patch"
  }
}
