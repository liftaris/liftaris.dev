# Cache immutable Vite/Astro build assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache static images, icons, and media with long-term caching
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/BazaarGhost/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
